{# templates/budget-documents-page.html.twig #}
<div class="g-content__switcher">
  <div class="g-content__switcher__hidden__item">
    <article class="norm-base__item odd_row">
      {% for document in documents %}
        <!--p>01.01.2014</p-->
      <div>
        {% set file_field_name = 'field_file' %}
        {% set file = document.get(file_field_name).entity %}
        {% if file %}
        <a href="{{ file_url(file.uri.value) }}">
          <span class="download_icon"></span>{{ document.label() }}<span></span>
        </a>
        {% endif %}
      </div>
      {% else %}
        <div>Нет документов</div>
      {% endfor %}
    </article>
  </div>
</div>
