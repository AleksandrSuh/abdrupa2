<?php

/**
 * @file
 * Функции установки, обновления и удаления модуля budget_execution.
 */

function budget_execution_schema() {
  $schema = [];

  $schema['budget_execution_base'] = [
    'description' => 'Хранение данных исполнения бюджета: доходы, расходы по отраслям, расходы по программам, бюджетные инвестиции, источники.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
        'description' => 'ID записи',
        'unsigned' => TRUE,
      ],
      'uuid' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
        'description' => 'UUID',
      ],
      'type' => [
        'type' => 'varchar',
        'length' => 20,
        'not null' => TRUE,
        'description' => 'Тип данных: income (доходы), expense_sector (расходы по отраслям), expense_program (расходы по программам), invest (бюджетные инвестиции),
      source (источники)',
      ],
      'category_code' => [
        'type' => 'varchar',
        'length' => 50,
        'not null' => TRUE,
        'description' => 'Код категории/отрасли/программы',
      ],
      'category_name' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => TRUE,
        'description' => 'Наименование категории/отрасли/программы',
      ],
      'date' => [  // ← ПРОСТОЕ СТРОКОВОЕ ПОЛЕ!
        'type' => 'varchar',
        'length' => 10,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Дата в формате YYYY-MM-DD',
      ],
      'plan_value' => [
        'type' => 'int',
        'size' => 'big',  // BIGINT для больших чисел
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Плановое значение',
        'unsigned' => TRUE,  // Бюджет не может быть отрицательным
      ],
      'actual_value' => [
        'type' => 'int',
        'size' => 'big',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Фактическое значение',
        'unsigned' => TRUE,
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Время создания записи (timestamp)',
      ],
      'changed' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Время последнего изменения записи (timestamp)',
      ],
      'uid' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'ID пользователя, создавшего/изменившего запись',
        'unsigned' => TRUE,
      ],
      'year' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Год, извлечённый из даты (для индексации)',
        'unsigned' => TRUE,
      ],
      'month' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Месяц, извлечённый из даты (для индексации)',
        'unsigned' => TRUE,
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'uuid' => ['uuid'],
      'type_category_date' => ['type', 'category_code', 'date'],
    ],
    'indexes' => [
      'type_date' => ['type', 'date'],
      'type_category' => ['type', 'category_code'],
      'date' => ['date'],
      'year_month' => ['year', 'month'],
    ],
    'foreign keys' => [
      'users' => [
        'table' => 'users',
        'columns' => ['uid' => 'uid'],
      ],
    ],
  ];

  $schema['budget_execution_indicators'] = [
    'description' => 'Динамика основных показателей бюджета',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
        'description' => 'Идентификатор записи',
      ],
      'type' => [
        'type' => 'varchar_ascii',
        'length' => 32,
        'not null' => TRUE,
        'description' => 'Тип: income или expense',
      ],
      'category' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'description' => 'Категория показателя',
      ],
      'value' => [
        'type' => 'numeric',
        'precision' => 15,
        'scale' => 2,
        'not null' => TRUE,
        'description' => 'Числовое значение',
      ],
      'year' => [
        'type' => 'int',
        'length' => 4,
        'not null' => TRUE,
        'description' => 'Год',
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Timestamp создания',
      ],
      'changed' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Timestamp изменения',
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'type_year' => ['type', 'year'],
      'category' => ['category'],
      'year' => ['year'],
    ],
  ];


  return $schema;
}
