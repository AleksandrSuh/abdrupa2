<a href="dynamic-indicators/add" class="button button--primary">Добавить новые данные</a>
<div class="budget-dynamic-indicators">
  <h2>Динамика основных показателей бюджета</h2>

  {% for year, types in data %}
    <div class="year-block">
      <h3>
        {{ year }} год
        {% if can_delete %}
          <a href="{{ path('budget_execution.dynamic_indicators_delete', {'year': year}) }}"
             class="button button--danger button--small"
             title="Удалить все данные за {{ year }} год">Удалить</a>
        {% endif %}
      </h3>

      {% if types.income %}
        <div class="income-section">
          <h4>Доходы</h4>
          <table>
            <tbody>
            {% for item in types.income %}
              <tr>
                <td>{{ item.category }}</td>
                <td>{{ item.value|number_format(2, '.', ' ') }}</td>
              </tr>
            {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
      {% if types.expense %}
        <div class="income-section">
          <h4>Расходы</h4>
          <table>
            <tbody>
            {% for item in types.expense %}
              <tr>
                <td>{{ item.category }}</td>
                <td>{{ item.value|number_format(2, '.', ' ') }}</td>
              </tr>
            {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}

    </div>
  {% else %}
    <p>Нет данных для отображения</p>
  {% endfor %}
</div>
