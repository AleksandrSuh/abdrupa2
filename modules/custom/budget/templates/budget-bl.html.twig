    </tr>
  </table>
  <table class="infoVertTable">
    <colgroup>
      <col width="150">
      <col>
      <col width="17">
      <col>
      <col width="17">
      <col>
    </colgroup>
    <tr class="green_text with-line">
      <td class="to_bottom"><div>Дефицит</div></td>
      {% for item in data.deficit %}
      <td>
        <div class="infoVert bot">
          <div class="text">{{ item.amount }}</div>
          <div class="iV_progress green" style="height: 100%;">
            <div class="text">{{ item.amount }}</div>
          </div>
        </div>
      </td>
        {% if not loop.last %}
