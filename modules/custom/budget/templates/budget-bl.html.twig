<div class="diagram">
  <table class="infoVertTableText">
    <colgroup>
      <col width="150">
      <col>
      <col width="17">
      <col>
      <col width="17">
      <col>
    </colgroup>
    <tr>
      {% for item in data.incomes %}
      <td></td>
      <td class="to_center">{{ item.year }}</td>
      {% endfor %}
    </tr>
  </table>

  <table class="infoVertTable">
    <colgroup>
      <col width="150">
      <col>
      <col width="17">
      <col>
      <col width="17">
      <col>
    </colgroup>
    <tr class="blue_text with-line">
      <td class="to_bottom"><div>Доходы</div></td>
      {% for item in data.incomes %}
      <td>
        <div class="infoVert bot">
          <div class="text">{{ item.amount }}</div>
          <div class="iV_progress blue" style="height: 100%;">
            <div class="text">{{ item.amount }}</div>
          </div>
        </div>
      </td>
        {% if not loop.last %}
      <td></td>
        {% endif %}
      {% endfor %}
