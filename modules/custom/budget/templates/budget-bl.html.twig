        <div class="infoVert bot">
          <div class="text">90 612</div>
          <div class="iV_progress blue" style="height: 96%;">
            <div class="text">90 612</div>
          </div>
        </div>
      </td>
      <td></td>
      <td>
        <div class="infoVert bot">
          <div class="text">94 541</div>
          <div class="iV_progress blue" style="height: 100%;">
            <div class="text">94 541</div>
          </div>
        </div>
      </td-->
    </tr>
    <tr class="red_text">
      <td class="to_top"><div>Расходы</div></td>
      {% for item in data.expenses %}
      <td>
        <div class="infoVert top">
          <div class="text">{{ item.amount }}</div>
          <div class="iV_progress red" style="height: 100%;">
            <div class="text">{{ item.amount }}</div>
          </div>
        </div>
      </td>
      {% if not loop.last %}
        <td></td>
      {% endif %}
      {% endfor %}
