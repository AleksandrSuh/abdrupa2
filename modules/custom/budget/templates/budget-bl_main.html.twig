<td>
<div class="whiteInfoBlock">
  <a href="/budget" class="title">Основные параметры бюджета, млн руб.</a>
  <table class="infoVertTableText">
    <colgroup>
      <col width="80">
      <col>
      <col width="17">
      <col>
      <col width="17">
      <col>
    </colgroup>
    <tr>
      {% for item in data.incomes %}
        <td></td>
        <td class="to_center">{{ item.year }}</td>
      {% endfor %}
    </tr>
  </table>
  <table class="infoVertTable">
    <tr class="blue_text">
      <td class="to_bottom" style="width:80px;"><div>Доходы</div></td>

      {% for item in data.incomes %}
        <td style="width:72px;">
          <div class="infoVert bot">
            <div class="text">{{ item.amount }}</div>
            <div class="iV_progress blue" style="height: 100%;">
              <div class="text">{{ item.amount }}</div>
            </div>
          </div>
        </td>
        {% if not loop.last %}
          <td></td>
        {% endif %}
      {% endfor %}
    </tr>
    <tr class="red_text">
      <td class="to_top" style="width:80px;"><div>Расходы</div></td>
      {% for item in data.expenses %}
        <td style="width:72px;">
          <div class="infoVert top">
            <div class="text">{{ item.amount }}</div>
            <div class="iV_progress red" style="height: 100%;">
              <div class="text">{{ item.amount }}</div>
            </div>
          </div>
        </td>
        {% if not loop.last %}
          <td></td>
        {% endif %}
      {% endfor %}
    </tr>
    <tr class="green_text">
      <td class="to_bottom" style="width:80px;"><div>Дефицит</div></td>
      {% for item in data.deficit %}
        <td style="width:72px;">
          <div class="infoVert bot">
            <div class="text">{{ item.amount }}</div>
            <div class="iV_progress green" style="height: 100%;">
              <div class="text">{{ item.amount }}</div>
            </div>
          </div>
        </td>
        {% if not loop.last %}
          <td></td>
        {% endif %}
      {% endfor %}
    </tr>
    <tr class="yellow_text">
      <td class="to_top" style="width:80px;"><div>Муниципальный<br/>долг</div></td>
      {% for item in data.mundolg %}
        <td style="width:72px;">
          <div class="infoVert top">
            <div class="text">{{ item.amount }}</div>
            <div class="iV_progress turq" style="height: 100%;">
              <div class="text">{{ item.amount }}</div>
            </div>
          </div>
        </td>
        {% if not loop.last %}
          <td></td>
        {% endif %}
      {% endfor %}
    </tr>
  </table>
</div>
</td>
<td></td>
<td>
  <div class="whiteInfoBlock">
    <a href="/execution"  class="title">Исполнение бюджета, млн руб.</a>

    <div class="date block_2">Исполнено на дату {{ data.date }}</div>
    <table class="infoTable">
      <colgroup>
        <col width="55">
        <col>
        <col width="80">
      </colgroup>
      <tr>
        <td></td>
        <td>Факт</td>
        <td>План</td>
      </tr>
      <tr class="blue_text">
        <td>Доходы</td>
        <td>
          <div class="infoGraph">
            <div class="ipg_text">
              {{ data.dohod.actual }} <div class="mini_text">{{ data.dohod.percent }}%</div>
            </div>
            {% set percentValue = data.dohod.percent|number_format(0, '.', '') %}
            <div class="ig_progress blue" style="width: {{ percentValue > 100 ? 100 : percentValue }}%;">
              <div class="ipg_text">
                {{ data.dohod.actual }} <div class="mini_text">{{ data.dohod.percent }}%</div>
              </div>
            </div>
          </div>
        </td>
        <td>
          <div class="execution_text">{{ data.dohod.plan }}</div>
          <p class="execution_price">млн руб.</p>
        </td>
      </tr>
      <tr class="red_text">
        <td>Расходы</td>
        <td>
          <div class="infoGraph">
            <div class="ipg_text">
              {{ data.rashod.actual }} <div class="mini_text">{{ data.rashod.percent }}%</div>
            </div>
            {% set percentValue = data.rashod.percent|number_format(0, '.', '') %}
            <div class="ig_progress red" style="width: {{ percentValue > 100 ? 100 : percentValue }}%;">
              <div class="ipg_text">
                {{ data.rashod.actual }} <div class="mini_text">{{ data.rashod.percent }}%</div>
              </div>
            </div>
          </div>
        </td>
        <td>
          <div class="execution_text">{{ data.rashod.plan }}</div>
          <p class="execution_price">млн руб.</p>
        </td>
      </tr>
    </table>
  </div>
</td>
