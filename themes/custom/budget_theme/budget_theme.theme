<?php

function budget_theme_preprocess_block(&$variables) {
  // Проверяем, что это блок меню
  if ($variables['plugin_id'] == 'system_menu_block:main') {
    // Получаем ID блока
    $block_id = $variables['elements']['#id'] ?? '';

    // Добавляем класс с ID блока к меню
    $variables['content']['#attributes']['class'][] = 'menu-block-' . str_replace('-', '_', $block_id);

    // Debug
    //\Drupal::messenger()->addMessage('Block ID: ' . $block_id);
    //\Drupal::messenger()->addMessage('Plugin ID: ' . $variables['plugin_id']);

    if (isset($variables['content']['#items'])) {
      $variables['content']['#attributes']['data-block-id'] = $block_id;
    }
  }

  $block = $variables['elements']['#block'] ?? NULL;

  if (!$block) {
    return;
  }

  // Получаем объект содержимого блока
  $plugin = $block->getPlugin();
  if (!$plugin instanceof \Drupal\block_content\Plugin\Block\BlockContentBlock) {
    return;
  }

  $block_content = $plugin->getEntity();
  if (!$block_content) {
    return;
  }

  // Получаем тип блока
  $bundle = $block_content->bundle();

  // ЕСЛИ ЭТО НАШ ТИП "Полезные ссылки" (замените на своё машинное имя)
  if ($bundle == 'main_links') {
    // НАЗНАЧАЕМ ИМЯ ШАБЛОНА - теперь вы его контролируете
    $variables['theme_hook_suggestions'][] = 'block__home_links';
  }

}
