{#
/**
 * @file
 * Шаблон для всего представления News в режиме блока.
 */
#}
<table>
  <tr>
    <td>
      <h1 class="main_title"><a href="/news/allnews">Новости</a></h1>
    </td>
        {# Выводим только строки, без обёрток unformatted #}
    {% if rows %}
      {% for row in rows %}
        {% if row['#rows'] is defined and row['#rows']|length > 0 %}
          {% for item in row['#rows'] %}
            {# Просто выводим уже отрендеренный контент #}
            {{ item }}
          {% endfor %}
        {% endif %}
      {% endfor %}
    {% endif %}
  </tr>
</table>
