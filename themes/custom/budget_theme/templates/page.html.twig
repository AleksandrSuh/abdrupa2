<script>
  function initFeedbackSendButton() {
    $('.popup_form_grid').on('keyup', function(){
      var valid = true;
      $(this).find('input, textarea').each(function(){
        valid = !!$(this).val() && valid;
      });
      if(!valid){
        $('#feedback-send-btn-1').addClass('inactive');
      }
      else{
        $('#feedback-send-btn-1').removeClass('inactive');
      }
    });

    $('#feedback-send-btn-1').click(function(e) {
      if($(this).hasClass('inactive')){
        return;
      }
      e.preventDefault();
      var sendBtn = this;
      $.ajax({type: "POST", url: "/ajax_feedback/addfeed",
        data: {
          name: $('#feedback-form-name-1').val(),
          email: $('#feedback-form-email-1').val(),
          message: $('#feedback-form-message-1').val(),
          verifyCode: $('#feedback-form-verifyCode-1').val()
        }
      }).done(function( msg ) {
        var str = '';
        if (msg.added == undefined && msg.errors == undefined) {
          alert('Не удалось отправить сообщение.');
          return;
        }
        $('.error-line').hide();
        if (msg.errors) {
          for (field in msg.errors) {
            if(msg.errors[field]) {
              var $errorContainer = $('.error-' + field + '-1');
              $errorContainer.find('.error-block').html(msg.errors[field]);
              $errorContainer.css('display', 'table-row');
            }
          }
          if (typeof msg.errors['verifyCode'] != 'undefined') {
            $('#captchaRefresh-1').trigger('click');
          }
          $('.PFG_line input[type="text"], .PFG_line textarea').focus(function() {
            var id = $(this).attr('id');
            id = id.replace('feedback-form-', '');
            $('.error-' + id).hide();
          });
        } else {
          $('#feedback-form-name-1').val('');
          $('#feedback-form-email-1').val('');
          $('#feedback-form-message-1').val('');
          $('#feedback-form-verifyCode-1').val('');
          $('.g-create-treatment__hint').fadeOut();
        }
        if (msg.added == 1) {
          $('[data-step]').hide();
          $('[data-step="2"]').fadeIn(function () {
            $('#captchaRefresh-1').trigger('click');
          });
        }
      });
    });
  }

  // Основной код
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof jQuery === 'undefined') {
      console.error('jQuery not found');
      return;
    }

    var $ = jQuery;
    initFeedbackSendButton();
  });
</script>
