{#
/**
 * @file
 * Шаблон для полного отображения документа типа docs.
 */
#}
<div class="breadcrumbs">
  <a href="/">Главная</a>
  <div>|</div>
  <a href="/payments/allpayments">Информация о платежных документах</a>
  <div>|</div>
  <span>{{ label }}</span>
</div>
         <h1>{{ label }}</h1>
<div class="parking">
  <div class="parking__list">
    <div class="parking__list__item">
      {% if node.field_file.entity %}
      {% set file = node.field_file.entity %}
      <div class="parking__list__item__title">{{ node.created.value|date('d.m.Y') }}</div>
      <div class="parking__list__item__text">{{ node.field_az_desc.value }}</div>
      <div class="parking__list__item__receipt">
        <div class="parking__list__item__receipt__img"><img src="/{{ active_theme_path() }}/img/icons/pdf.svg" alt="pdf"></div>
        <div class="parking__list__item__receipt__right">
          <div class="parking__list__item__receipt__right__look"><img src="/{{ active_theme_path() }}/img/icons/eye.svg" alt="look" width="34px" height="19px"><a href="{{ file_url(file.uri.value) }}" target="_blank">Посмотреть реквизиты для оплаты</a></div>
          <div class="parking__list__item__receipt__right__print"><img src="/{{ active_theme_path() }}/img/icons/print.svg" alt="print" width="35px" height="20px"><a href="#" onClick="printPdf('{{ file_url(file.uri.value) }}')">Распечатать реквизиты для оплаты</a></div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
</div>



